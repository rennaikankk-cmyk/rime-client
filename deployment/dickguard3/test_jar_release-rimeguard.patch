+    def test_rimeguard31_requires_both_entrypoints_and_guard_class(self):
+        base = {"id":"guizhouware", "version":"1.1.1", "depends":{"minecraft":"1.21.11"},
+                "entrypoints":{"main":["d1.G"],"client":["d1.G"]}, "custom":{"rimeguard":"3.1"}}
+        valid = jar(metadata=base,extra=[("d1/G.class",b"fixture guard")])
+        response = self.upload(valid)
+        self.assertEqual(response.status_code,200)
+        for metadata in [
+                {**base,"entrypoints":{"client":["d1.G"]}},
+                {**base,"entrypoints":{"main":["dev.guizhou.GuizhouWare"],"client":["d1.G"]}},
+                {**base,"custom":{"rimeguard":"4.0"}}]:
+            self.assertNotEqual(self.upload(jar(metadata=metadata,extra=[("d1/G.class",b"fixture guard")])).status_code,200)
+        self.assertNotEqual(self.upload(jar(metadata=base)).status_code,200)
+
+    def test_guard_aliases_reject_conflicts_and_invalid_versions(self):
+        base = {"id":"guizhouware", "version":"1.1.1", "depends":{"minecraft":"1.21.11"},
+                "entrypoints":{"main":["d1.G"],"client":["d1.G"]}}
+        for custom in [{"rimeguard":"3.1","dickguard":"3.0"}, {"rimeguard":None},
+                       {"dickguard":None}, {"rimeguard":[]}, {"rimeguard":"3.1","dickguard":None}]:
+            self.assertEqual(self.upload(jar(metadata={**base,"custom":custom},extra=[("d1/G.class",b"guard")])).status_code,400)
+        valid={**base,"custom":{"rimeguard":"3.1","dickguard":"3.1"}}
+        self.assertEqual(self.upload(jar(metadata=valid,extra=[("d1/G.class",b"guard")])).status_code,200)
