+    def test_coupled_client_fixture_and_strict_extension(self):
+        path = Path(__file__).with_name("coupled_summary_fixture.ndjson")
+        event = json.loads(path.read_text().strip())
+        data = event["data"]
+        coupled = data["config"]["coupled"]
+        self.assertEqual(set(coupled), set(telemetry.COUPLED_CONFIG_FIELDS))
+        self.assertEqual(self.post(batch("flight_summary", data)).status_code, 202)
+        rows = self.exported("?type=flight_summary")
+        self.assertEqual(rows[0]["event"]["data"]["config"]["coupled"], coupled)
+        for key in coupled:
+            broken = copy.deepcopy(data)
+            del broken["config"]["coupled"][key]
+            with self.subTest(missing=key):
+                self.assertEqual(self.post(batch("flight_summary", broken)).status_code, 400)
+        for key, value in (("pitch", 90), ("climb_pitch", 1), ("descent_pitch", -1),
+                           ("descent_floor", 1), ("height_window", 0), ("speed_cap", 16),
+                           ("box_cap", 0), ("inset", -0.1), ("smart_climb", 1),
+                           ("porpoise", "true"), ("auto_fly", "false"), ("unknown", 1)):
+            broken = copy.deepcopy(data)
+            broken["config"]["coupled"][key] = value
+            with self.subTest(invalid=key):
+                self.assertEqual(self.post(batch("flight_summary", broken)).status_code, 400)
+
